[remap]

importer="wav"
type="AudioStreamWAV"
path="res://.godot/imported/music.wav-00000000000000000000000000000000.sample"
deps=["res://assets/audio/music.wav"]

[params]

compress/mode=0
edit/loop_mode=1
edit/loop_begin=0
edit/loop_end=-1
edit/normalize=false
edit/trim=false
force/8_bit=false
force/mono=false
force/max_rate=false
force/max_rate_hz=44100
