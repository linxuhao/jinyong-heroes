[gd_scene load_steps=5 format=3]

; Persistent shell (step2_design C1): SceneManager (autoload) hosts exactly one
; active segment scene as a child of SceneHost. HUD/Tutorial layers persist.
; menu.tscn duplicates the main.tscn shell node block VERBATIM (the shell cannot
; be refactored into a shared base while main.tscn stays byte-identical) plus one
; authored MenuPanel under SegmentHost. The MenuPanel's _ready claims the boot
; (SceneManager.claim_boot) before SceneManager's post-frame default battlefield
; swap, so real launches land on the menu while all 27 legacy scenario boots of
; main.tscn keep current_scene == "none" and swap exactly as before.

[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/tutorial_overlay.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu_panel.tscn" id="3"]
[ext_resource type="Script" path="res://scripts/camera_follower.gd" id="4"]

[node name="Main" type="Node2D"]

[node name="Camera" type="Camera2D" parent="."]
script = ExtResource("4")
position = Vector2(480, 352)
enabled = true
current = true

[node name="SceneHost" type="Node2D" parent="."]

; SegmentLayer hosts the six segment scenes. SceneHost is a plain Node2D whose
; anchorable rect is empty, so a Control parented under it sizes to 0x0 and
; renders nothing — segment roots must hang under this full-rect Control inside
; a CanvasLayer instead (get_anchorable_rect falls back to the viewport rect for
; non-CanvasItem parents).
[node name="SegmentLayer" type="CanvasLayer" parent="."]
layer = 1
follow_viewport_enabled = false

[node name="SegmentHost" type="Control" parent="SegmentLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="MenuPanel" parent="SegmentLayer/SegmentHost" instance=ExtResource("3")]

[node name="HUDLayer" type="CanvasLayer" parent="."]
layer = 10
follow_viewport_enabled = false

[node name="HUD" parent="HUDLayer" instance=ExtResource("1")]

[node name="TutorialLayer" type="CanvasLayer" parent="."]
layer = 100
follow_viewport_enabled = false

[node name="TutorialOverlay" parent="TutorialLayer" instance=ExtResource("2")]
