[node name="SceneHost" type="Node2D" parent="."]

; SegmentLayer hosts the six segment scenes. SceneHost is a plain Node2D whose
; anchorable rect is empty, so a Control parented under it sizes to 0x0 and
; renders nothing — segment roots must hang under this full-rect Control inside
; a CanvasLayer instead (get_anchorable_rect falls back to the viewport rect for
; non-CanvasItem parents).
